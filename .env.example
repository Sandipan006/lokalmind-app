# =============================
# LokalMind .env.example
# =============================

# --- EAS / Expo (build-time only, not bundled in app) ---
EAS_PROJECT_ID=
APP_OWNER=

# --- Hetzner Storage (model hosting) ---
HETZNER_BASE_URL=
HETZNER_WEBDAV_URL=
MODEL_METADATA_PATH=

# --- LLM defaults ---
CTX_SIZE_DEFAULT=
CHAT_MAX_TOKENS=

# --- Download ---
DOWNLOAD_CHUNK_SIZE=
DOWNLOAD_CONCURRENCY=

# --- Private (CI/scripts only — never bundled in app) ---
HETZNER_SSH_HOST=
HETZNER_SSH_USER=
HETZNER_SSH_PATH=
HETZNER_WEBDAV_USERNAME=
HETZNER_WEBDAV_PASSWORD=
