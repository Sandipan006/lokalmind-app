# =============================
# LokalMind .env.example
# =============================
# Copy this file to .env and fill in the blanks marked with <required>.
# Values already filled in are public defaults - they work out of the box.

# --- EAS / Expo ---
# Only needed for EAS cloud builds (eas build / eas submit).
# For local development (npx expo run:ios / run:android) these can be left blank.
EAS_PROJECT_ID=
APP_OWNER=

# --- Model CDN ---
# Public Cloudflare Worker proxy - no credentials needed.
HETZNER_BASE_URL=https://lokalmind-models.sandipan-lokalmind.workers.dev
HETZNER_WEBDAV_URL=https://lokalmind-models.sandipan-lokalmind.workers.dev
MODEL_METADATA_PATH=models/metadata.json

# --- LLM defaults ---
CTX_SIZE_DEFAULT=2048
CHAT_MAX_TOKENS=512

# --- Download tuning ---
DOWNLOAD_CHUNK_SIZE=8388608
DOWNLOAD_CONCURRENCY=3

# --- Bundle IDs (required for native builds, keep private) ---
IOS_BUNDLE_IDENTIFIER=
ANDROID_PACKAGE=

# --- Support links (optional - leave blank to hide payment buttons) ---
SUPPORT_PAYPAL_URL=
SUPPORT_OTHER_PAYMENT_URL=

# --- App metadata ---
GITHUB_REPO_URL=https://github.com/Sandipan006/lokalmind-app
DEVELOPER_CONTACT_EMAIL=

# --- CI / server-side only - never used by the app ---
# These are for uploading new models to Hetzner via SSH/SCP scripts.
# Contributors do not need these.
HETZNER_SSH_HOST=
HETZNER_SSH_USER=
HETZNER_SSH_PATH=
